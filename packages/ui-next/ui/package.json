{
  "name": "@arvin-studio/ui",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "sideEffects": [
    "./dist/reset.css",
    "./dist/as.css",
    "./dist/as-with-locales.js",
    "./dist/as-with-locales.esm.js",
    "./dist/as.esm.js",
    "./dist/as.js"
  ],
  "unpkg": "./dist/as-with-locales.js",
  "jsdelivr": "./dist/as-with-locales.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./with-locales": {
      "types": "./dist/index.with-locales.d.ts",
      "import": "./dist/index.with-locales.js",
      "default": "./dist/index.with-locales.js"
    },
    "./dist/*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "import": [
        "./dist/*.js",
        "./dist/*/index.js"
      ],
      "default": [
        "./dist/*.js",
        "./dist/*/index.js"
      ]
    },
    "./dist/locale/*": {
      "types": "./dist/locale/*.d.ts",
      "import": "./dist/locale/*.js",
      "default": "./dist/locale/*.js"
    },
    "./locale/*": {
      "types": "./dist/locale/*.d.ts",
      "import": "./dist/locale/*.js",
      "default": "./dist/locale/*.js"
    },
    "./date-picker/*": {
      "types": [
        "./dist/date-picker/*.d.ts",
        "./dist/date-picker/*/index.d.ts"
      ],
      "import": [
        "./dist/date-picker/*.js",
        "./dist/date-picker/*/index.js"
      ],
      "default": [
        "./dist/date-picker/*.js",
        "./dist/date-picker/*/index.js"
      ]
    },
    "./date-picker/locale/*": {
      "types": "./dist/date-picker/locale/*.d.ts",
      "import": "./dist/date-picker/locale/*.js",
      "default": "./dist/date-picker/locale/*.js"
    },
    "./time-picker/*": {
      "types": [
        "./dist/time-picker/*.d.ts",
        "./dist/time-picker/*/index.d.ts"
      ],
      "import": [
        "./dist/time-picker/*.js",
        "./dist/time-picker/*/index.js"
      ],
      "default": [
        "./dist/time-picker/*.js",
        "./dist/time-picker/*/index.js"
      ]
    },
    "./time-picker/locale/*": {
      "types": "./dist/date-picker/locale/*.d.ts",
      "import": "./dist/date-picker/locale/*.js",
      "default": "./dist/date-picker/locale/*.js"
    },
    "./date-picker/generate": {
      "types": "./dist/date-picker/generate/index.d.ts",
      "import": "./dist/date-picker/generate/index.js",
      "default": "./dist/date-picker/generate/index.js"
    },
    "./date-picker/generate/*": {
      "types": [
        "./dist/date-picker/generate/*.d.ts",
        "./dist/date-picker/generate/*/index.d.ts"
      ],
      "import": [
        "./dist/date-picker/generate/*.js",
        "./dist/date-picker/generate/*/index.js"
      ],
      "default": [
        "./dist/date-picker/generate/*.js",
        "./dist/date-picker/generate/*/index.js"
      ]
    },
    "./global.d.ts": "./global.d.ts",
    "./global": "./global.d.ts",
    "./config-provider": {
      "types": "./dist/config-provider/index.d.ts",
      "import": "./dist/config-provider/index.js",
      "default": "./dist/config-provider/index.js"
    },
    "./config-provider/context": {
      "types": "./dist/config-provider/context.d.ts",
      "import": "./dist/config-provider/context.js",
      "default": "./dist/config-provider/context.js"
    },
    "./config-provider/DisabledContext": {
      "types": "./dist/config-provider/DisabledContext.d.ts",
      "import": "./dist/config-provider/DisabledContext.js",
      "default": "./dist/config-provider/DisabledContext.js"
    },
    "./config-provider/hooks/useSize": {
      "types": "./dist/config-provider/hooks/useSize.d.ts",
      "import": "./dist/config-provider/hooks/useSize.js",
      "default": "./dist/config-provider/hooks/useSize.js"
    },
    "./config-provider/hooks/useCSSVarCls": {
      "types": "./dist/config-provider/hooks/useCSSVarCls.d.ts",
      "import": "./dist/config-provider/hooks/useCSSVarCls.js",
      "default": "./dist/config-provider/hooks/useCSSVarCls.js"
    },
    "./theme/internal": {
      "types": "./dist/theme/internal.d.ts",
      "import": "./dist/theme/internal.js",
      "default": "./dist/theme/internal.js"
    },
    "./theme/interface/components": {
      "types": "./dist/theme/interface/components.d.ts",
      "import": "./dist/theme/interface/components.js",
      "default": "./dist/theme/interface/components.js"
    },
    "./dist/reset.css": "./dist/reset.css",
    "./dist/as.css": "./dist/as.css",
    "./dist/as-with-locales.js": {
      "types": "./dist/index.with-locales.d.ts",
      "default": "./dist/as-with-locales.js"
    },
    "./dist/as-with-locales.esm.js": {
      "types": "./dist/index.with-locales.d.ts",
      "default": "./dist/as-with-locales.esm.js"
    },
    "./dist/as.esm.js": "./dist/as.esm.js",
    "./dist/as.js": "./dist/as.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-s build:esm build:vite:parallel build:verify",
    "build:verify": "tsx ./scripts/verify-browser-bundle.ts",
    "build:esm": "tsdown",
    "build:with-locales": "run-p build:with-locales:esm build:with-locales:umd",
    "build:with-locales:esm": "cross-env WITH_LOCALES_FORMAT=es vite build --config ./vite.with-locales.config.ts",
    "build:with-locales:umd": "cross-env WITH_LOCALES_FORMAT=umd vite build --config ./vite.with-locales.config.ts",
    "build:all": "pnpm run build && pnpm run build:with-locales",
    "build:vite:parallel": "run-p build:umd build:full-esm build:with-locales",
    "build:full-esm": "vite build --config ./vite.esm.config.ts",
    "build:umd": "vite build",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "publint && attw --pack .",
    "prepublishOnly": "pnpm run build:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/throttle-debounce": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "cross-env": "catalog:",
    "npm-run-all": "catalog:",
    "vite": "catalog:",
    "vite-plugin-tsx-resolve-types": "^1.0.1",
    "vue": "catalog:"
  },
  "dependencies": {
    "@arvin-studio/core": "workspace:*",
    "@arvin-studio/cssinjs": "workspace:*",
    "@arvin-studio/headless": "workspace:*",
    "@arvin-studio/icons": "workspace:*",
    "@arvin-studio/kit": "workspace:*",
    "@vueuse/core": "catalog:",
    "dayjs": "catalog:",
    "dom-zindex": "catalog:",
    "scroll-into-view-if-needed": "catalog:",
    "throttle-debounce": "catalog:"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
