{
  "name": "@arvin-studio/kit",
  "version": "1.0.0",
  "description": "ArvinStudio 工具函数库",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "types": "./es/index.d.ts",
  "unpkg": "./dist/all.esm.js",
  "jsdelivr": "./dist/all.esm.js",
  "exports": {
    ".": {
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./*": {
      "import": {
        "types": "./es/*.d.ts",
        "default": "./es/*.js"
      },
      "require": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      }
    },
    "./dist/all.esm.js": {
      "types": "./es/index.d.ts",
      "default": "./dist/all.esm.js"
    }
  },
  "files": [
    "dist",
    "es",
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "utils",
    "tools",
    "kit"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4"
}
